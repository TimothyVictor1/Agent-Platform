DATABASE_URL=
REDIS_URL=
APP_API_TOKEN=
APP_MODELS_FILE=config/models.yaml
APP_POLICIES_FILE=config/policies.yaml
# Artifact storage backend: fs | s3
ARTIFACT_STORE=fs
ARTIFACT_DIR=./data/artifacts
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
E2B_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
LOCAL_LLM_KEY=
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_API_TOKEN=
NEXT_PUBLIC_MOCK=0
NEXT_PUBLIC_APP_NAME=Agent Platform
APP_API_PORT=8000
PORT=3000
APP_DB_NAME=agentplatform
# Host port of the compose Postgres. It must not clash with a local Postgres
# (e.g. Homebrew on 5432); if it does, pick a free port and point DATABASE_URL at it.
APP_PG_PORT=5432
# Host port of the compose Redis. Change it if 6379 is taken; point REDIS_URL at it.
APP_REDIS_PORT=6379
APP_WORKTREE=
APP_LIVE=0
APP_DOCKER=0
# Interface the API binds to. Keep 127.0.0.1 unless a TLS proxy is in front and APP_API_TOKEN is set.
APP_API_HOST=127.0.0.1
# Passwords of the compose Postgres and Redis, used when DATABASE_URL/REDIS_URL are empty.
# Empty keeps the local defaults (Postgres "agentplatform", Redis without a password).
# Real deployments must set strong values; a new Postgres password only applies to a new volume.
APP_PG_PASSWORD=
APP_REDIS_PASSWORD=
# Runtime owner name in session leases (empty: host-pid-random).
APP_RUNTIME_ID=
# Memory limit of each docker_local desktop (also its memory+swap limit, so no swap).
APP_DOCKER_MEM_LIMIT=2g
# Longest E2B sandbox lifetime in minutes; longer requests are capped with a warning.
APP_E2B_MAX_LIFETIME_MIN=60
# A restarted runtime adopts completed sessions this many hours old (for follow-ups).
APP_ADOPT_COMPLETED_HOURS=24
# Seconds after which a session still planning without a plan is planned again.
APP_PLANNING_SWEEP_S=60
# Minutes between orphaned-sandbox cleanups (also run at startup).
APP_ORPHAN_SWEEP_MIN=10
# docker_local sandbox egress: open (default) or proxy. With proxy, sandboxes have no
# route to the host or the internet; only the compose egress-proxy is reachable, and it
# refuses destinations that resolve to non-public addresses (docs/security.md).
# Start the proxy first: docker compose --profile egress up -d egress-proxy
APP_SANDBOX_EGRESS=open
# Container name of the egress proxy (compose default shown).
APP_EGRESS_PROXY_CONTAINER=agentplatform-egress-proxy-1
# Exact host names the proxy lets resolve to private addresses (the eval fixture site).
APP_EGRESS_ALLOW_PRIVATE_HOSTS=eval-fixtures
